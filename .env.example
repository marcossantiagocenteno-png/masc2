# Variables de configuración de Novel Engine.
#
# La aplicación NO lee ningún archivo .env automáticamente. Para cambiar un valor,
# expórtalo en la terminal antes de arrancar, por ejemplo:
#   export NOVEL_ENGINE_MAX_VERSION_CHARS=200000
#
# No escribas aquí secretos reales. Todos los valores son marcadores o valores por defecto.

# Base de datos (SQLAlchemy). Por defecto: data/novel_engine.sqlite dentro del repositorio.
# Solo SQLite está probado. PostgreSQL no está soportado todavía: las migraciones
# rechazan cualquier motor que no sea SQLite.
# DATABASE_URL=sqlite:////ruta/absoluta/a/novel_engine.sqlite

# Límite de caracteres por versión, tras normalizar el texto. Por defecto: 500000.
# NOVEL_ENGINE_MAX_VERSION_CHARS=500000

# Proveedor de análisis editorial. Por defecto: simulado (no es una IA).
# Ningún otro valor está autorizado. Cualquier otro responde 503.
# NOVEL_ENGINE_ANALYSIS_PROVIDER=simulado

# Tamaño máximo de un fragmento a analizar. Por defecto: 8000.
# NOVEL_ENGINE_MAX_ANALYSIS_CHARS=8000

# Orígenes del frontend permitidos por CORS. Por defecto: localhost:3000 y 127.0.0.1:3000.
# NOVEL_ENGINE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# URL de la API que consume el frontend (prefijo NEXT_PUBLIC_: visible en el navegador).
# Por defecto: http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Intérprete Python con las dependencias de backend, usado por las pruebas E2E.
# Por defecto: backend/.venv/bin/python
# NOVEL_ENGINE_PYTHON=/ruta/a/python

# Chromium ya instalado, si no se usa el navegador de Playwright.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/ruta/a/chromium
