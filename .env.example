# Plantilla de configuración de Novel Engine.
# Copia este archivo a `.env` (ignorado por git) y ajusta los valores.
# NO escribas aquí secretos reales. Los valores de este archivo son marcadores.

# Entorno: development | test | production
NOVEL_ENGINE_ENV=development

# Nivel de registro del backend: debug | info | warning | error
LOG_LEVEL=info

# Persistencia futura (PostgreSQL). Todavía no es leída por ningún código.
DATABASE_URL=postgresql+psycopg://novel_engine:CAMBIAR_CONTRASENA@localhost:5432/novel_engine

# URL pública del backend que consume el frontend (prefijo NEXT_PUBLIC_ = visible en el navegador).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Chromium para Playwright, solo si no se usa el navegador que instala Playwright.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=
